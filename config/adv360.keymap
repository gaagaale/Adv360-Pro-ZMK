#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&hm LEFT_GUI GRAVE          &kp LEFT_GUI  &kp LALT      &kp RCTRL  &kp LEFT_SHIFT  &kp LA(LG(RCTRL))  &tog 1                                                                &mo 3      &kp RA(RG(RCTRL))  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &hm RIGHT_GUI MINUS
&hm LEFT_ALT LT             &kp Q         &kp W         &kp E      &kp R           &kp T              &none                                                                 &none      &kp Y              &kp U            &kp I      &kp O          &kp P          &hm RIGHT_ALT GREATER_THAN
&hm LCTRL LEFT_BRACKET      &kp A         &kp S         &kp D      &kp F           &kp G              &none            &kp LCTRL  &kp LALT        &kp LGUI    &kp RCTRL     &none      &kp H              &kp J            &kp K      &kp L          &kp SEMICOLON  &hm RCTRL RIGHT_BRACKET
&hm LSHFT LEFT_PARENTHESIS  &kp Z         &kp X         &kp C      &kp V           &kp B                                          &none           &none                                &kp N              &kp M            &kp COMMA  &kp DOT        &kp FSLH       &hm RSHFT RIGHT_PARENTHESIS
&mo 2                       &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT                     &lt 1 BACKSPACE  &lt 4 TAB  &kp ESCAPE      &kp ESCAPE  &lt 5 RETURN  &kp SPACE                     &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp PLUS   &kp NUMBER_1  &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                    &mo 3      &kp N6            &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY    &kp MINUS
&kp TAB    &kp Q         &kp W     &kp E     &kp R      &kp T   &none                                                     &none      &kp LEFT_BRACKET  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp RIGHT_BRACKET  &kp BSLH
&kp ESC    &kp A         &kp S     &kp D     &kp F      &kp G   &none     &kp KP_NUM  &kp LALT      &kp LGUI   &tog 1     &none      &kp EQUAL         &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS        &kp SQT
&kp LSHFT  &kp Z         &kp X     &kp C     &kp V      &kp B                         &kp HOME      &kp PG_UP                        &kp BACKSLASH     &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER       &kp RSHFT
&mo 2      &kp GRAVE     &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL     &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0                    &kp KP_DOT  &kp DOWN      &kp KP_DOT     &kp RBKT           &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&none   &kp F2   &kp F3  &kp F4  &kp F5  &kp F6           &tog 1                                      &mo 3   &kp F7          &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN  &none                                       &none   &kp SYSREQ      &kp F7  &kp F8  &kp F9   &trans   &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK   &none   &trans  &trans      &trans  &trans  &none   &kp SCROLLLOCK  &kp F4  &kp F5  &kp F6   &trans   &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK                  &trans      &trans                  &kp C_PAUSE     &kp F1  &kp F2  &kp F3   &trans   &trans
&trans  &trans   &trans  &trans  &trans                   &trans  &trans  &trans      &trans  &trans  &trans                  &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        sym {
            bindings = <
&none  &none         &none         &none      &none           &none  &none                                      &none  &none           &none            &none         &none                 &none            &none
&none  &none         &none         &none      &none           &none  &none                                      &none  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE  &none
&none  &none         &none         &none      &none           &none  &none  &none  &none      &none  &none      &none  &kp PLUS        &kp DOLLAR       &kp PERCENT   &kp CARET             &kp TILDE        &none
&none  &none         &none         &none      &none           &none                &none      &none                    &kp PIPE        &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp QUESTION     &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT         &none  &none  &none      &none  &kp MINUS  &none                  &none            &none         &none                 &none            &none
            >;
        };

        nav {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };
    };
};
